{
  "entity": {
    "binary_sensor": {
      "match_today": {
        "default": "mdi:tennis",
        "state": {
          "off": "mdi:calendar-blank-outline"
        }
      }
    },
    "calendar": {
      "matches": {
        "default": "mdi:tennis"
      }
    },
    "event": {
      "match_update": {
        "default": "mdi:bell-ring-outline"
      }
    },
    "sensor": {
      "singles_rating": {
        "default": "mdi:account"
      },
      "doubles_rating": {
        "default": "mdi:account-multiple"
      },
      "padel_rating": {
        "default": "mdi:racquetball"
      },
      "matches_won": {
        "default": "mdi:trophy-outline"
      },
      "matches_lost": {
        "default": "mdi:close-circle-outline"
      },
      "last_result": {
        "default": "mdi:scoreboard",
        "state": {
          "won": "mdi:trophy",
          "lost": "mdi:emoticon-sad-outline"
        }
      },
      "last_match": {
        "default": "mdi:calendar-check"
      },
      "next_match": {
        "default": "mdi:tennis-ball"
      },
      "competition_position": {
        "default": "mdi:podium"
      },
      "ranking": {
        "default": "mdi:format-list-numbered"
      },
      "tournament_entries": {
        "default": "mdi:clipboard-list-outline"
      }
    }
  },
  "services": {
    "get_matches": {
      "service": "mdi:tennis-ball"
    },
    "get_standings": {
      "service": "mdi:podium"
    }
  }
}
